# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/*.tfvars
!terraform/*.tfvars.example
terraform/crash.log
terraform/crash.*.log

# Override files (LocalStack) — nunca commitados, só locais
terraform/*_override.tf
!terraform/*_override.tf.example

# Pacote gerado pelo archive_file (build artifact, não fonte)
terraform/lambda-function.zip

# Python
__pycache__/
*.pyc
.pytest_cache/
